# ai-service/.env.example — AllowanceAI v2
# Copy to .env and fill in real values. .env is git-ignored; never commit it.

# ─── Database (PostgreSQL + pgvector — same DB as server/) ───────────────────
DATABASE_URL=postgresql://<user>:<password>@<host>:5432/<dbname>

# ─── Cache / Chat memory ─────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ─── Message queue ────────────────────────────────────────────────────────────
RABBITMQ_URL=amqp://<user>:<password>@<host>:5672

# ─── LLM ─────────────────────────────────────────────────────────────────────
OPENAI_API_KEY=sk-your-key-here
# Optional: override base URL for OpenRouter or other compatible endpoints
# OPENAI_BASE_URL=https://openrouter.ai/api/v1
OPENAI_MODEL=gpt-4o-mini

# ─── Observability / tracing ──────────────────────────────────────────────────
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
# Optional: self-hosted Langfuse instance URL; omit to use langfuse.cloud
# LANGFUSE_HOST=https://langfuse.example.com

# ─── Error tracking ───────────────────────────────────────────────────────────
SENTRY_DSN=

# ─── Service ──────────────────────────────────────────────────────────────────
PORT=8000
ENVIRONMENT=development
