# ai-service/.env.example — AllowanceAI v2
# Copy to .env and fill in real values. .env is git-ignored; never commit it.

# ─── Database (PostgreSQL + pgvector — same DB as server/) ───────────────────
# Local compose maps Postgres to host 5433 (native Postgres often owns 5432).
DATABASE_URL=postgresql://<user>:<password>@<host>:5433/<dbname>

# ─── Cache / Chat memory ─────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ─── Message queue ────────────────────────────────────────────────────────────
RABBITMQ_URL=amqp://<user>:<password>@<host>:5672

# ─── LLM ─────────────────────────────────────────────────────────────────────
OPENAI_API_KEY=sk-your-key-here
# Optional: override base URL for OpenRouter or other compatible endpoints
# OPENAI_BASE_URL=https://openrouter.ai/api/v1
OPENAI_MODEL=gpt-4o-mini

# ─── Observability / tracing ──────────────────────────────────────────────────
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
# Optional: self-hosted Langfuse instance URL; omit to use langfuse.cloud
# LANGFUSE_HOST=https://langfuse.example.com

# ─── Error tracking ───────────────────────────────────────────────────────────
SENTRY_DSN=

# ─── Internal auth (REQUIRED for /assistant/*) ────────────────────────────────
# The /assistant/* endpoints take a user_id in the request body and return that user's
# financial history, so they must never be reachable from a browser. The trust chain is:
#     browser -> server/ (verifies the user's JWT) -> ai-service (verifies THIS token)
# Set the same value here and as INTERNAL_API_TOKEN on the API server.
#
# There is deliberately NO development default: a default would be a hardcoded credential
# in a public repo. If this is unset, every /assistant/* endpoint answers 503 rather than
# serving — it fails closed, not open. Generate one with:
#     python -c "import secrets; print(secrets.token_urlsafe(32))"
INTERNAL_API_TOKEN=

# ─── Service ──────────────────────────────────────────────────────────────────
PORT=8000
ENVIRONMENT=development
