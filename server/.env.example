# server/.env.example — AllowanceAI v2
# Copy to .env and fill in real values. .env is git-ignored; never commit it.

# ─── Database (PostgreSQL + pgvector) ────────────────────────────────────────
# DATABASE_URL is the connection the running app uses.
# DIRECT_URL is used ONLY by the Prisma CLI (migrate / introspect). schema.prisma
# declares `directUrl`, so DIRECT_URL must always be set or every Prisma CLI
# command fails with P1012 "Environment variable not found: DIRECT_URL".
#
# Local dev / CI (plain Postgres, no pooler — set both to the same value).
# docker-compose maps host 5433 -> container 5432 so native PG17 can keep 5432:
#   postgresql://allowance:allowance_dev_secret@localhost:5433/allowanceai
#
# Production on Supabase (free tier) — two DIFFERENT strings:
#   DATABASE_URL = Transaction pooler, port 6543, with ?pgbouncer=true
#     postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true
#   DIRECT_URL   = Session pooler, port 5432 (no pgbouncer flag)
#     postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
#
# Why: the transaction pooler cannot hold prepared statements (hence pgbouncer=true)
# and drops the advisory lock `prisma migrate deploy` needs, so migrations must not
# run through port 6543. Copy both strings from Supabase Dashboard > Connect.
# Never commit real values — this file holds placeholders only.
DATABASE_URL=postgresql://<user>:<password>@<host>:5433/<dbname>
DIRECT_URL=postgresql://<user>:<password>@<host>:5433/<dbname>

# ─── Cache / Sessions ────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ─── Message queue ────────────────────────────────────────────────────────────
# Local dev (matches docker-compose defaults):
#   amqp://allowance:allowance_dev_secret@localhost:5672
RABBITMQ_URL=amqp://<user>:<password>@<host>:5672

# ─── Auth ─────────────────────────────────────────────────────────────────────
JWT_SECRET=replace-with-at-least-32-random-chars

# ─── Google OAuth ─────────────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:5000/api/auth/google/callback

# ─── CORS ─────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins
CLIENT_URL=http://localhost:5173

# ─── AI service ───────────────────────────────────────────────────────────────
AI_SERVICE_URL=http://localhost:8000

# ─── Ingestion: Setu Account Aggregator (sandbox only — do not flip to prod) ──
SETU_ENV=sandbox
SETU_BASE_URL=https://fiu-sandbox.setu.co
SETU_CLIENT_ID=
SETU_CLIENT_SECRET=
SETU_PRODUCT_INSTANCE_ID=

# ─── Ingestion: Gmail (fallback — only needed if AA integration stalls) ────────
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=

# ─── Error tracking ───────────────────────────────────────────────────────────
SENTRY_DSN=

# ─── File storage (Cloudflare R2) ─────────────────────────────────────────────
R2_ACCESS_KEY=
R2_SECRET_KEY=
R2_BUCKET_NAME=
R2_ENDPOINT=https://<account_id>.r2.cloudflarestorage.com

# ─── Legacy v1 MongoDB (OPTIONAL — do not set in production) ─────────────────
# Only the not-yet-migrated v1 routes (expenses, jars, splits, wishlist, ...) use
# this. Auth, budgets, goals, categories and ingestion are all PostgreSQL/Prisma.
# Leave it unset and the server skips Mongo entirely and still boots and logs in.
# MONGO_URI=

# ─── Server ───────────────────────────────────────────────────────────────────
PORT=5000
NODE_ENV=development
