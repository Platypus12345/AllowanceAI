# server/.env.example — AllowanceAI v2
# Copy to .env and fill in real values. .env is git-ignored; never commit it.

# ─── Database (PostgreSQL + pgvector) ────────────────────────────────────────
# Local dev (matches docker-compose defaults; host 5433, container still 5432):
#   postgresql://allowance:allowance_dev_secret@localhost:5433/allowanceai
DATABASE_URL=postgresql://<user>:<password>@<host>:5433/<dbname>

# ─── Cache / Sessions ────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ─── Message queue ────────────────────────────────────────────────────────────
# Local dev (matches docker-compose defaults):
#   amqp://allowance:allowance_dev_secret@localhost:5672
RABBITMQ_URL=amqp://<user>:<password>@<host>:5672

# ─── Auth ─────────────────────────────────────────────────────────────────────
JWT_SECRET=replace-with-at-least-32-random-chars

# ─── Google OAuth ─────────────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:5000/api/auth/google/callback

# ─── CORS ─────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins
CLIENT_URL=http://localhost:5173

# ─── AI service ───────────────────────────────────────────────────────────────
AI_SERVICE_URL=http://localhost:8000

# ─── Ingestion: Setu Account Aggregator (sandbox) ─────────────────────────────
SETU_CLIENT_ID=
SETU_CLIENT_SECRET=

# ─── Ingestion: Gmail (fallback — only needed if AA integration stalls) ────────
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=

# ─── Error tracking ───────────────────────────────────────────────────────────
SENTRY_DSN=

# ─── File storage (Cloudflare R2) ─────────────────────────────────────────────
R2_ACCESS_KEY=
R2_SECRET_KEY=
R2_BUCKET_NAME=
R2_ENDPOINT=https://<account_id>.r2.cloudflarestorage.com

# ─── Server ───────────────────────────────────────────────────────────────────
PORT=5000
NODE_ENV=development
